  //RCLCPP_INFO(rclcpp::get_logger("rclcpp"), "Ready to send velocities to platform 1.");

  //rclcpp::spin(AStarServer);

    


    auto node = std::make_shared<AStarServer>();
    rclcpp::spin(node);

  rclcpp::shutdown();

  return 0;
}




